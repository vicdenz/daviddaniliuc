{
  "name": "daviddaniliuc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:resume": "bash scripts/sync_resume.sh",
    "test:audio": "node --experimental-strip-types --test tests/audio.test.mjs",
    "test:audio:http": "node --test tests/audio-http.test.mjs",
    "check:audio": "node scripts/check_audio.mjs",
    "deploy:preview": "npm run check:audio && npx --yes vercel@65.2.0 deploy",
    "deploy:prod": "npm run check:audio && npx --yes vercel@65.2.0 deploy --prod",
    "dev": "npm run build:prep && next dev --port 3000",
    "build": "npm run check:audio && npm run build:prep && next build",
    "start": "next start",
    "lint": "eslint .",
    "build:prep": "node scripts/build_prep.mjs",
    "test:prep": "node --env-file=.env.local --test tests/prep-http.test.mjs tests/prep-restart.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/sandbox": "^3.9.0",
    "next": "^15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rough-notation": "^0.5.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.179.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "raw-loader": "^4.0.2",
    "typescript": "^5"
  }
}
