# CLI uploads local files, including Git-ignored audio. Exclude local secrets
# and build artifacts; ordinary source files are included automatically.
**/.env*
**/*.pem
**/*.local.json
**/.DS_Store
*.tsbuildinfo
*.log
**/__pycache__/
/coverage/
/out/
/build/
/prep/data/*.sqlite*
/prep/data/
/prep/data/*.json
/prep/data/originals/
/prep/problems/
/prep/reviewed/
/prep/scripts/
/prep/tests/
/prep/docs/
/prep/deploy/
/prep/node_modules/
/prep/dist/
/prep/.venv/
