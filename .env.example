# Required in Vercel Preview and Production. Use a random secret of at least
# 32 characters (for example, generate one with: openssl rand -hex 32).
# Local development uses a development-only fallback when this is unset.
AUDIO_SESSION_SECRET=

# Private prep backend; these values are server-only.
PREP_SUPABASE_URL=
PREP_SUPABASE_SECRET_KEY=
PREP_PASSWORD=
PREP_SESSION_SECRET=
PREP_CPP_SNAPSHOT_ID=
