# Upload only deployment inputs. This file takes precedence over .gitignore
# for CLI uploads, so local MP3s are included while secrets stay excluded.
/*
!/src/
!/src/**
!/public/
!/public/**
!/private/
!/private/**
!/scripts/
!/scripts/**
!/package.json
!/package-lock.json
!/next.config.ts
!/tsconfig.json
!/eslint.config.mjs
!/vercel.json
!/next-env.d.ts

# Upload the track manifest and MP3 assets from the private audio directory.
/private/*
!/private/audio/
/private/audio/*
!/private/audio/*.mp3
!/private/audio/tracks.json

# Never upload local environment files, including nested ones.
**/.env*
**/.DS_Store
